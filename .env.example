# Required: the password that unlocks the manager interface.
# Manager access stays blocked until this is set.
MANAGER_PASSWORD=

# Optional: signs the session tokens.
# Left empty, a new secret is generated at every start, which logs managers out
# and gives players a fresh identity on each restart. Running games are lost on
# a restart anyway, so this only matters if you want sessions to survive one.
# Must be at least 32 characters. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=
